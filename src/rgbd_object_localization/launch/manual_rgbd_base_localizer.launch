<?xml version="1.0"?>

<launch>
  <arg name="base_frame" default="panda_link0" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />
  <arg name="color_topic" default="/camera/color/image_raw" />
  <arg
    name="depth_topic"
    default="/camera/aligned_depth_to_color/image_raw"
  />
  <arg name="camera_point_topic" default="/object_position/camera" />
  <arg name="base_point_topic" default="/object_position/base" />
  <arg name="depth_scale" default="0.001" />
  <arg name="depth_window_radius" default="3" />
  <arg name="publish_calibration" default="true" />
  <arg
    name="calibration_file"
    default="$(find rgbd_object_localization)/config/panda_realsense_eye_on_base_eye_on_base.yaml"
  />

  <!-- Do not enable this while another node publishes the same static TF. -->
  <group if="$(arg publish_calibration)">
    <include file="$(find easy_handeye)/launch/publish.launch">
      <arg name="eye_on_hand" value="false" />
      <arg
        name="namespace_prefix"
        value="panda_realsense_eye_on_base"
      />
      <arg name="calibration_file" value="$(arg calibration_file)" />
    </include>
  </group>

  <node
    pkg="rgbd_object_localization"
    type="manual_rgbd_base_localizer.py"
    name="manual_rgbd_base_localizer"
    output="screen"
  >
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="color_topic" value="$(arg color_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_point_topic" value="$(arg camera_point_topic)" />
    <param name="base_point_topic" value="$(arg base_point_topic)" />
    <param name="depth_scale" value="$(arg depth_scale)" />
    <param name="depth_window_radius" value="$(arg depth_window_radius)" />
  </node>
</launch>
