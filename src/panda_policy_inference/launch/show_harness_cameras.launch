<launch>
  <!-- Show-Harness consumes RGB images only. Keep unused streams off. -->
  <arg name="serial_no_camera1" default="213522251541" />
  <arg name="serial_no_camera2" default="213522252775" />
  <arg name="enable_camera1" default="true" />
  <arg name="color_width" default="640" />
  <arg name="color_height" default="480" />
  <arg name="color_fps" default="30" />
  <arg name="enable_depth" default="false" />

  <include file="$(find realsense2_camera)/launch/rs_camera.launch" if="$(arg enable_camera1)">
    <arg name="camera" value="camera1" />
    <arg name="serial_no" value="$(arg serial_no_camera1)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
    <arg name="enable_color" value="true" />
    <arg name="enable_depth" value="$(arg enable_depth)" />
    <arg name="enable_confidence" value="false" />
    <arg name="enable_infra" value="false" />
    <arg name="enable_infra1" value="false" />
    <arg name="enable_infra2" value="false" />
    <arg name="enable_pointcloud" value="false" />
    <arg name="align_depth" value="false" />
  </include>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="camera2" />
    <arg name="serial_no" value="$(arg serial_no_camera2)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
    <arg name="enable_color" value="true" />
    <arg name="enable_depth" value="$(arg enable_depth)" />
    <arg name="enable_confidence" value="false" />
    <arg name="enable_infra" value="false" />
    <arg name="enable_infra1" value="false" />
    <arg name="enable_infra2" value="false" />
    <arg name="enable_pointcloud" value="false" />
    <arg name="align_depth" value="false" />
  </include>
</launch>
