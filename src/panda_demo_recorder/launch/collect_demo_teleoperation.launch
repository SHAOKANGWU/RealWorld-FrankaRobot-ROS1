<launch>
  <arg name="output_root"
       default="$(env HOME)/ros_franka_robotlearn/data/teleoperation" />
  <arg name="config_file"
       default="$(find panda_demo_recorder)/config/demo_recorder.yaml" />
  <arg name="controller_config_file"
       default="$(find panda_custom_controllers)/config/cartesian_velocity_teleop_controller.yaml" />
  <arg name="spacemouse_config_file"
       default="$(find panda_spacemouse_teleop)/config/spacemouse.yaml" />
  <arg name="robot_ip" />
  <arg name="load_gripper" default="true" />
  <arg name="start_controller" default="true" />

  <!-- Start the camera that publishes /camera/color/image_raw. -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch" />

  <include file="$(find panda_spacemouse_teleop)/launch/teleop.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="load_gripper" value="$(arg load_gripper)" />
    <arg name="start_controller" value="$(arg start_controller)" />
    <arg name="controller_config_file" value="$(arg controller_config_file)" />
    <arg name="config_file" value="$(arg spacemouse_config_file)" />
  </include>

  <include file="$(find panda_demo_recorder)/launch/demo_recorder.launch">
    <arg name="output_root" value="$(arg output_root)" />
    <arg name="config_file" value="$(arg config_file)" />
  </include>
</launch>
