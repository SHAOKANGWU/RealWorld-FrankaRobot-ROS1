<launch>
  <arg name="config_file"
       default="$(find panda_reproduction)/config/joint_position_reproduction.yaml"/>
  <arg name="controller_config_file"
       default="$(find panda_custom_controllers)/config/joint_position_torque_controller.yaml"/>
  <arg name="trajectory_file" default=""/>
  <arg name="robot_ip" />
  <arg name="load_gripper" default="true" />

  <param name="/use_sim_time" value="false" />

  <include file="$(find franka_control)/launch/franka_control.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="load_gripper" value="$(arg load_gripper)" />
  </include>

  <rosparam command="load"
            file="$(arg controller_config_file)" />
  <param name="/joint_position_torque_controller/enable_gripper"
         value="$(arg load_gripper)" />

  <!-- Load and start the arm controller before replaying its commands. -->
  <node pkg="controller_manager"
        type="spawner"
        name="joint_position_torque_controller_spawner"
        args="joint_position_torque_controller"
        output="screen" />

  <rosparam command="load" file="$(arg config_file)"/>
  <param name="/joint_position_reproduction/trajectory_file"
         value="$(arg trajectory_file)"
         if="$(eval arg('trajectory_file') != '')"/>
  <node pkg="panda_reproduction"
        type="joint_position_reproduction.py"
        name="joint_position_reproduction"
        output="screen"/>
</launch>
