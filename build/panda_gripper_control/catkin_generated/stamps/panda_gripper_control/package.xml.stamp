<?xml version="1.0"?>
<package format="2">
  <name>panda_gripper_control</name>
  <version>0.1.0</version>
  <description>Keyboard control for the Franka gripper action servers.</description>

  <maintainer email="robot-learn@todo.todo">robot-learn</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>franka_gripper</depend>
  <depend>rospy</depend>
</package>
