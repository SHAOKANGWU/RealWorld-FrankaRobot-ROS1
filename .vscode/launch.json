{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "validate_demo",
            "type": "debugpy",
            "request": "launch",
            "program": "/home/robot-learn/ros_franka_robotlearn/src/panda_demo_recorder/scripts/validate_demo.py",
            "console": "integratedTerminal",
            "args": ["/home/robot-learn/ros_franka_robotlearn/data/kinesthetic/demo_0001"]
        },

        {
            "name": "convert_trajectory_to_txt",
            "type": "debugpy",
            "request": "launch",
            "program": "/home/robot-learn/ros_franka_robotlearn/src/panda_demo_recorder/scripts/convert_trajectory_to_txt.py",
            "console": "integratedTerminal",
            "args": ["/home/robot-learn/ros_franka_robotlearn/data/kinesthetic/demo_0001"]
        },

        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/fastKMP/MiKMP_Drawing_benchmark",
            // "args": [
            //     "true",
            //     // "1",
            //     // "1"
            // ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
